{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User account information and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastLoginAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "WorkspaceConfig": {
      "title": "Workspace Configuration",
      "description": "Customized settings and presets for the user's workspace including background, audio, method, layout, and appearance",
      "type": "object",
      "properties": {
        "background": { "type": "object" },
        "audio": { "type": "object" },
        "method": { "type": "object" },
        "layout": { "type": "object" },
        "appearance": { "type": "object" },
        "viewMode": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "Template": {
      "title": "Workspace Template",
      "description": "Personal (isGroup: 0) or Group/Team (isGroup: 1, max 5 members stored in template data) reusable focus workspace setup",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "creatorId": { "type": "string" },
        "creatorName": { "type": "string" },
        "creatorPhoto": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array" },
        "thumbnail": { "type": "string" },
        "config": { "type": "object" },
        "tasks": { "type": "array" },
        "stickyNotes": { "type": "array" },
        "notepad": { "type": "string" },
        "isPublic": { "type": "boolean" },
        "isGroup": { "type": "number", "description": "0 = individual/personal template, 1 = group template" },
        "members": { "type": "array", "description": "Array of member objects (maximum 5 members) stored directly in template data" },
        "memberUids": { "type": "array", "description": "Array of user UIDs (maximum 5) for querying" },
        "price": { "type": "number" },
        "downloadCount": { "type": "number" },
        "likesCount": { "type": "number" },
        "likedBy": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "creatorId", "name", "config"]
    },
    "CustomImageRecord": {
      "title": "Custom User Image Record",
      "description": "User uploaded or clipboard added image record preserved in cloud storage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "type": { "type": "string" },
        "url": { "type": "string" },
        "thumbnailUrl": { "type": "string" },
        "source": { "type": "string" },
        "isCustom": { "type": "boolean" },
        "isPreservedAfterReset": { "type": "boolean" },
        "hasResetCustoms": { "type": "boolean" },
        "addedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "url"]
    },
    "RollbackSnapshot": {
      "title": "Workspace Rollback Snapshot",
      "description": "Saved version snapshot taken prior to workspace custom reset for version rollback",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "config": { "type": "object" },
        "tasks": { "type": "array" },
        "stickyNotes": { "type": "array" },
        "notepad": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "timestamp", "config"]
    },
    "Streak": {
      "title": "User Focus Streak",
      "description": "Daily consecutive focus streak records, milestone unlocks, and activity history belonging to the user",
      "type": "object",
      "properties": {
        "currentStreak": { "type": "number" },
        "longestStreak": { "type": "number" },
        "lastFocusDate": { "type": "string" },
        "totalFocusDays": { "type": "number" },
        "milestones": { "type": "array" },
        "streakHistory": { "type": "array" },
        "freezeDaysAvailable": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["currentStreak", "longestStreak", "lastFocusDate"]
    },
    "FocusLog": {
      "title": "Focus Log Record",
      "description": "Historical focus duration, session counts, and task completion records per day",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "totalFocusTime": { "type": "number" },
        "tasksCompleted": { "type": "number" },
        "methodUsed": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "date", "totalFocusTime"]
    }
  },
  "firestore": {
    "collections": {
      "users": {
        "entity": "UserProfile",
        "description": "User profile collection",
        "access": {
          "read": "auth.uid == resource.data.uid || auth.uid == userId",
          "write": "auth.uid == userId"
        },
        "subcollections": {
          "workspace": {
            "entity": "WorkspaceConfig",
            "access": {
              "read": "auth.uid == userId",
              "write": "auth.uid == userId"
            }
          },
          "imageLibrary": {
            "entity": "CustomImageRecord",
            "access": {
              "read": "auth.uid == userId",
              "write": "auth.uid == userId"
            }
          },
          "rollbackSnapshot": {
            "entity": "RollbackSnapshot",
            "access": {
              "read": "auth.uid == userId",
              "write": "auth.uid == userId"
            }
          },
          "templates": {
            "entity": "Template",
            "access": {
              "read": "auth.uid == userId",
              "write": "auth.uid == userId"
            }
          },
          "tasks": {
            "access": {
              "read": "auth.uid == userId",
              "write": "auth.uid == userId"
            }
          },
          "stickyNotes": {
            "access": {
              "read": "auth.uid == userId",
              "write": "auth.uid == userId"
            }
          },
          "notepad": {
            "access": {
              "read": "auth.uid == userId",
              "write": "auth.uid == userId"
            }
          },
          "focusLogs": {
            "access": {
              "read": "auth.uid == userId",
              "write": "auth.uid == userId"
            }
          },
          "streak": {
            "access": {
              "read": "auth.uid == userId",
              "write": "auth.uid == userId"
            }
          }
        }
      },
      "templates": {
        "entity": "Template",
        "description": "Community marketplace templates for workspace setups",
        "access": {
          "read": "true",
          "create": "auth != null && request.resource.data.creatorId == auth.uid",
          "update": "auth != null",
          "delete": "auth != null && resource.data.creatorId == auth.uid"
        }
      }
    }
  }
}
