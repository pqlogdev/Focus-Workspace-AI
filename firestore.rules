rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile and all subcollections (workspace, templates, tasks, stickyNotes, notepad, focusLogs, streak)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Community / Public & Group templates
    match /templates/{templateId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.creatorId == request.auth.uid ||
        (resource.data.memberUids != null && request.auth.uid in resource.data.memberUids) ||
        // Allow users to increment downloadCount or toggle likes
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['downloadCount', 'likesCount', 'likedBy'])
      );
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }
  }
}
